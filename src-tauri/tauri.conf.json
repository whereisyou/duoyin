{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "duoyin",
  "version": "0.1.0",
  "identifier": "com.duoyin.app",
  "build": {
    "beforeDevCommand": "npx vite dev --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "多音 · 视频翻译配音",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}